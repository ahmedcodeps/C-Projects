[sub_resource type="RectangleShape2D" id="RectangleShape2D_6ulbd"]
size = Vector2(70, 342)

[sub_resource type="Resource" id="Resource_tl2vt"]
script = ExtResource("7_vk6js")
Question = "What are you?"
Answer = "I am a demon who comes from the lower dimensions where most demon-folk dwell, I came to the mid dimension looking for employment."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_lnu2h"]
script = ExtResource("7_vk6js")
Question = "The mid dimension?"
Answer = "It is a point between realms that exists due to the convergence of dimensions, it is kind of like the lettuce in a human sandwich."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_l4yof"]
script = ExtResource("7_vk6js")
Question = "How did I get here?"
Answer = "This is quite the unique case, i've never seen a human down here let alone any being for that matter, except the occasional wandering souls of course. However my best guess was that you died and were specifically brought down with your soul and body still intact. Only the strongest of magic could do something like that."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_lc1h1"]
script = ExtResource("7_vk6js")
Question = "Magic?"
Answer = "Magic is what keeps worlds like these alive, it created demons and ghosts and the such. To learn more though you must explore past this place, there is an apt magic weilder north from here. But be very careful, you will need resources to continue."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_vk6js"]
script = ExtResource("7_vk6js")
Question = "Resources?"
Answer = "Hmm, there is a sword near an opened chest that will do you some good, you may also need a torch. I left a spare somewhere around here, it's yours if you can find it."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_4wlns"]
script = ExtResource("8_nvn3l")
Entries = Array[ExtResource("7_vk6js")]([SubResource("Resource_tl2vt"), SubResource("Resource_lnu2h"), SubResource("Resource_l4yof"), SubResource("Resource_lc1h1"), SubResource("Resource_vk6js")])
metadata/_custom_type_script = "uid://57kp05yg4oqg"


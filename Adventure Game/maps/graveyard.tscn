[node name="GraveMenu" parent="Grave" unique_id=1287567084 instance=ExtResource("13_ejwsh")]
Messages = Array[String](["BOO! Hah, did I scare you?", "You're probably wondering where you are right now, this is a very old battlefield turned graveyard. So old infact that it sunk into the earth and ended up in a between realm.", "Me and my comrades fell in battle millions of years ago, their souls are long gone now. But for some reason my soul cannot be pulled down to the lower worlds. I believe this has something to do with the magic surronding this place.", "Oh, If you have any inquiries about how you got here, magic, or anything of the such you can talk to the gravekeeper. Don't be fooled by his looks, he's very friendly."])


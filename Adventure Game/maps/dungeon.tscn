[sub_resource type="Resource" id="Resource_s748n"]
script = ExtResource("23_syv8x")
Question = "Are you the magician?"
Answer = "Yes, I am. I'm sorry I couldn't see you sooner, I had buisness to attend to."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_oqhnu"]
script = ExtResource("23_syv8x")
Question = "Are you human?"
Answer = "No, I'm a fairy but I took the form of a human due to my previously small body not being able to withstand my power, I found that the human body was the perfect fit for me."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_synb2"]
script = ExtResource("23_syv8x")
Question = "Buisness?"
Answer = "I will tell you about that but not here, I have a challenge for you."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_ardp7"]
script = ExtResource("23_syv8x")
Question = "Challenge?"
Answer = "Yes, In order to prove yourself for the ultimate test you must defeat this vast wave of enemies I have prepared for you."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_ao43o"]
script = ExtResource("23_syv8x")
Question = "Enemies?"
Answer = "I've gathered The strongest beings in the realm, demons, I believe you've met one before however that was a grave keeper and these ones are fighters. I believe you have what it takes to win, good luck."
metadata/_custom_type_script = "uid://1276wtqbq50j"


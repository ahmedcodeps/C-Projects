[sub_resource type="TileSet" id="TileSet_6ulbd"]
physics_layer_0/collision_layer = 1
physics_layer_0/collision_mask = 7
sources/0 = SubResource("TileSetAtlasSource_r7ad2")

[sub_resource type="Resource" id="Resource_e37be"]
script = ExtResource("5_2jbb2")
Question = "How did I get here?"
Answer = "This place is special see, it blocks a lot of the fast travel transmissions stopping the travel and dropping you here. "
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_buoti"]
script = ExtResource("5_2jbb2")
Question = "How do I get to the doctor?"
Answer = "Oh... The doctor.. Well, I have a challenge for you, if you can defeat all the monsters that have been plauging this place than I will open a pathway through the sand for you."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_78koj"]
script = ExtResource("5_2jbb2")
Question = "Monsters?"
Answer = "You must defeat the Orcs and Slimes of this area, I'm sure you've encountered slimes before. Orcs are violent, strong, angry, and hate humans. Slimes can be found roaming around the desert, Orcs prefer to be inside some kind of enclosing like the various old structures around here. Defeat all of them and I will open a pathway for you in the sand."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_g3thb"]
script = ExtResource("5_2jbb2")
Question = "Stronger items?"
Answer = " There is a strong weapon here that can help you deal more damage to the Orcs along with a more powerful torch."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_sgry1"]
script = ExtResource("5_2jbb2")
Question = "After I complete the challenge?"
Answer = "Go to the middle of the desert where there is small light and you will see what looks like a mark, walk inside and you will be taken to the realm of the Doctor."
metadata/_custom_type_script = "uid://1276wtqbq50j"

[sub_resource type="Resource" id="Resource_4nmxw"]
script = ExtResource("6_hlevs")
Entries = Array[ExtResource("5_2jbb2")]([SubResource("Resource_e37be"), SubResource("Resource_buoti"), SubResource("Resource_78koj"), SubResource("Resource_g3thb"), SubResource("Resource_sgry1")])
metadata/_custom_type_script = "uid://57kp05yg4oqg"

